---
import Layout from '../layouts/Layout.astro';
import EstadoHorario from '../components/EstadoHorario.astro';
import { SITE, u } from '../lib/site';
---
<Layout>
  <section class="hero reveal">
    <p class="eyebrow">Universidad Nacional de Colombia · Sede Bogotá</p>
    <h1>{SITE.nombre}</h1>
    <p class="sig">{SITE.largo}</p>
    <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
    <EstadoHorario />
    <div class="cta"><a class="btn gold" href={u('/menu/')}>Ver el menú</a><a class="btn ghost" href={SITE.mapa}>Cómo llegar</a></div>
  </section>
  <section class="grid">
    <a class="card reveal" href={u('/acerca/')}><h2>Lorem ipsum</h2><p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p><span class="go">Conocer más →</span></a>
    <a class="card reveal" href={u('/menu/')}><h2>Dolor sit amet</h2><p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p><span class="go">Ver el menú →</span></a>
    <a class="card reveal" href={u('/apoya/')}><h2>Consectetur</h2><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p><span class="go">Cómo apoyar →</span></a>
  </section>
</Layout>
