---
import Layout from '../layouts/Layout.astro';
import EstadoHorario from '../components/EstadoHorario.astro';
import { SITE, u } from '../lib/site';
---
<Layout>
  <section class="hero reveal">
    <p class="eyebrow">Universidad Nacional de Colombia · Sede Bogotá</p>
    <h1>{SITE.nombre}</h1>
    <p class="sig">{SITE.largo}</p>
    <p class="lead">{SITE.lema}.</p>
    <EstadoHorario />
    <div class="cta">
      <a class="btn gold" href={u('/menu/')}>Ver el menú</a>
      <a class="btn ghost" href={SITE.mapa}>Cómo llegar</a>
    </div>
  </section>
  <section class="grid">
    <a class="card reveal" href={u('/acerca/')}>
      <h2>Quiénes somos</h2>
      <p>Conoce el proceso estudiantil detrás de La Kokoa.</p>
      <span class="go">Conocer más →</span>
    </a>
    <a class="card reveal" href={u('/menu/')}>
      <h2>Menú de la semana</h2>
      <p>Desayuno, almuerzo y cena de lunes a sábado.</p>
      <span class="go">Ver el menú →</span>
    </a>
    <a class="card reveal" href={u('/apoya/')}>
      <h2>Aportes voluntarios</h2>
      <p>Si quieres sostener el proceso, aquí te contamos cómo.</p>
      <span class="go">Cómo apoyar →</span>
    </a>
  </section>
</Layout>
