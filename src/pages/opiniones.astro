---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---
<Layout title="Opiniones">
  <header class="page-head reveal">
    <p class="eyebrow">Tu voz cuenta</p>
    <h1>Opiniones</h1>
    <p class="lead">Cuéntanos cómo te fue en tu visita.</p>
  </header>
  <section class="panel reveal">
    <p>Recibimos las opiniones en Google Maps.</p>
    <a class="btn" href={SITE.mapa}>Opinar en Google Maps</a>
  </section>
</Layout>
