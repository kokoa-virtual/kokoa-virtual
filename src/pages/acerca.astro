---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';

const [abre, cierra] = SITE.horarios[1] ?? ['', ''];
---
<Layout title="Acerca">
  <header class="page-head reveal">
    <p class="eyebrow">Quiénes somos</p>
    <h1>Acerca</h1>
    <p class="lead">{SITE.descripcion}</p>
  </header>
  <section class="prose reveal">
    <p>{SITE.nombre}, {SITE.largo}, funciona en {SITE.direccion}.</p>
    <p>Abrimos de lunes a viernes, de {abre} a {cierra}.</p>
  </section>
</Layout>
