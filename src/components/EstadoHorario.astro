---
import { SITE, DIAS } from '../lib/site';
---
<p id="estado" class="estado" role="status" data-h={JSON.stringify(SITE.horarios)} data-z={SITE.zona} data-d={JSON.stringify(DIAS)}>Calculando horario…</p>
<script>
  type Franja = [string, string] | null;

  const el = document.getElementById('estado');
  if (el) {
    const horarios: Record<number, Franja> = JSON.parse(el.dataset.h ?? '{}');
    const dias: string[] = JSON.parse(el.dataset.d ?? '[]');
    const zona = el.dataset.z ?? 'America/Bogota';
    const SEMANA = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const formato = new Intl.DateTimeFormat('en-US', { timeZone: zona, weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false });

    const minutos = (hora: string): number => Number(hora.slice(0, 2)) * 60 + Number(hora.slice(3));

    const pintar = (): void => {
      const partes = Object.fromEntries(formato.formatToParts(new Date()).map((x) => [x.type, x.value]));
      const dia = SEMANA.indexOf(partes.weekday);
      const ahora = (Number(partes.hour) % 24) * 60 + Number(partes.minute);
      const hoy = horarios[dia];
      let texto = 'Cerrado por ahora';
      let clase = 'cerrado';

      if (hoy && ahora >= minutos(hoy[0]) && ahora < minutos(hoy[1])) {
        clase = 'abierto';
        texto = `Abierto ahora · cierra a las ${hoy[1]}`;
      } else {
        for (let k = 0; k < 8; k++) {
          const d = (dia + k) % 7;
          const franja = horarios[d];
          if (!franja || (k === 0 && ahora >= minutos(franja[0]))) continue;
          const cuando = k === 0 ? 'hoy' : k === 1 ? 'mañana' : `el ${dias[d].toLowerCase()}`;
          texto = `Cerrado · abre ${cuando} a las ${franja[0]}`;
          break;
        }
      }

      if (el.textContent !== texto) el.textContent = texto;
      el.className = `estado ${clase}`;
    };

    pintar();
    setInterval(pintar, 30000);
  }
</script>
