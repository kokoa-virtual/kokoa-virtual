---
import '../styles/global.css';
import { SITE, NAV, u } from '../lib/site';
const anio = new Date().getFullYear();
interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.descripcion } = Astro.props;
const full = title ? `${title} · ${SITE.nombre}` : `${SITE.nombre} · ${SITE.largo}`;
const canon = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: SITE.largo,
  url: Astro.site,
  description: SITE.descripcion,
  address: { '@type': 'PostalAddress', streetAddress: SITE.direccion, addressLocality: 'Bogotá', addressCountry: 'CO' },
  sameAs: [SITE.instagram],
};
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
const here = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canon} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:url" content={canon} />
  <meta name="theme-color" content="#1C5038" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#152C21" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={u('/logo.png')} type="image/png" />
  <link rel="apple-touch-icon" href={u('/logo.png')} />
  <link rel="preload" href={u('/fonts/figtree.woff')} as="font" type="font/woff" crossorigin />
  <link rel="stylesheet" href={u('/fonts/fuentes.css')} />
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('cocina-central-tema'); } catch (e) { t = null; }
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    })();
  </script>
  <script type="application/ld+json" set:html={ldJson} />
</head>
<body id="top">
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="top">
    <a class="logo" href={u('/')}><img class="mark" src={u('/logo.png')} width="40" height="40" alt="" /><span>La Kokoa</span></a>
    <nav aria-label="Principal">
      {NAV.map(({ ruta, etiqueta }) => <a href={u(ruta)} aria-current={here === u(ruta).replace(/\/$/, '') ? 'page' : undefined}>{etiqueta}</a>)}
    </nav>
    <div class="acts">
      <button id="tema" class="btn ghost" type="button" aria-label="Cambiar entre modo claro y oscuro"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg></button>
      <a class="btn gold" href={u('/virtual/')}>Iniciar sesión</a>
    </div>
  </header>
  <main id="contenido" tabindex="-1"><slot /></main>
  <footer class="foot">
    <div class="foot-in">
      <div>
        <a class="logo" href={u('/')}><img class="mark" src={u('/logo.png')} width="40" height="40" alt="" /><span>La Kokoa</span></a>
        <p>{SITE.descripcion}</p>
      </div>
      <nav aria-label="Pie de página">
        <h2>Explora</h2>
        <ul>
          {NAV.map(({ ruta, etiqueta }) => <li><a href={u(ruta)}>{etiqueta}</a></li>)}
          <li><a href={u('/virtual/')}>Iniciar sesión</a></li>
        </ul>
      </nav>
      <div>
        <h2>Encuéntranos</h2>
        <ul>
          <li>{SITE.direccion}</li>
          <li><a href={SITE.mapa}>Cómo llegar</a></li>
          <li><a href={SITE.instagram}>Instagram · @kokoa_chucholeon</a></li>
          {SITE.whatsapp && <li><a href={`https://wa.me/${SITE.whatsapp}`}>WhatsApp</a></li>}
        </ul>
      </div>
    </div>
    <div class="foot-bar"><span>© {anio} {SITE.largo}</span><a href="#top">Volver arriba ↑</a></div>
  </footer>
  <script>
    const raiz = document.documentElement;
    const CLAVE_TEMA = 'cocina-central-tema';

    function guardarTema(tema: string): void {
      try {
        localStorage.setItem(CLAVE_TEMA, tema);
      } catch {
        return;
      }
    }

    document.getElementById('tema')?.addEventListener('click', () => {
      const actual = raiz.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const siguiente = actual === 'dark' ? 'light' : 'dark';
      raiz.dataset.theme = siguiente;
      guardarTema(siguiente);
    });
  </script>
</body>
</html>
